# Database
# Requires the pgvector extension. The app applies it on boot (idempotent, and
# non-fatal on failure); to run it manually: npm run db:init
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_support

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# AI/LLM
GOOGLE_API_KEY=your-google-api-key
LLM_MODEL=gemini-2.0-flash

# Knowledge base embeddings (semantic retrieval)
# Required for pgvector cosine search. Without it the app still runs, but every
# knowledge-base answer is served in 'keyword-degraded' mode (lexical scoring in
# Node instead of vector search) and that mode is reported in the chat payload
# as retrievalMode: "keyword-degraded".
OPENAI_API_KEY=your-openai-api-key
# Must be a 1536-dimension model; the pgvector column is vector(1536).
EMBEDDING_MODEL=text-embedding-3-small

# Frontend
FRONTEND_URL=http://localhost:3000

# Server
PORT=4000
NODE_ENV=development
